.container {
  padding: 40rpx;
  min-height: 100vh;
  background: #F5F7F6;
}

.tabs {
  display: flex;
  justify-content: space-around;
  margin-bottom: 60rpx;
}

.tab {
  font-size: 36rpx;
  color: #6B7772;
  padding-bottom: 16rpx;
  font-weight: 500;
}

.tab.active {
  color: #12A87A;
  font-weight: bold;
  border-bottom: 6rpx solid #12A87A;
}

.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(18, 168, 122, 0.05);
}

.input-group {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #1F2A26;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #F5F7F6;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

/* 绿色登录/注册按钮 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  background: #12A87A;
  color: #FFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 20rpx;
  padding: 0; /* 清除默认内边距 */
  
  /* 使用 Flex 完美居中 */
  display: flex;
  justify-content: center;
  align-items: center;
}
/* 去除微信默认按钮边框 */
.btn-primary::after {
  border: none;
}

/* 微信授权登录按钮 */
.btn-wx {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  color: #12A87A;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: 2rpx solid #12A87A;
  padding: 0; /* 清除默认内边距 */
  
  /* 使用 Flex 完美居中 */
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 去除微信默认按钮边框 */
.btn-wx::after {
  border: none;
}

.divider {
  display: flex;
  align-items: center;
  margin: 60rpx 0;
}

.line {
  flex: 1;
  height: 1rpx;
  background: #E0E6E3;
}

.text {
  font-size: 24rpx;
  color: #9AA5A0;
  padding: 0 20rpx;
}

.wx-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}
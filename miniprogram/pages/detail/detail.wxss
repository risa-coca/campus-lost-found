.cover {
  width: 100%;
  height: 460rpx;
  border-radius: 24rpx;
  background: #E9F7F1;
}

.info {
  padding: 28rpx;
  margin-top: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2A26;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #6B7772;
  padding: 12rpx 0;
}

.meta-label {
  color: #9AA5A0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #3A4641;
  line-height: 1.7;
  white-space: pre-wrap;
}

.close-btn {
  margin-top: 32rpx;
}

.match-section {
  border: 2rpx solid #E9F7F1;
  background: #F8FDFA;
}

.match-header {
  margin-bottom: 20rpx;
}

.ai-badge {
  background: #12A87A;
  color: #FFF;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.match-item {
  border-top: 1rpx solid #E9F7F1;
  padding: 20rpx 0;
}

.match-score {
  color: #E5533D;
  font-weight: bold;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.match-desc {
  font-size: 26rpx;
  color: #3A4641;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.match-link {
  font-size: 24rpx;
  color: #12A87A;
}

.action-footer {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.contact-btn {
  background: #12A87A;
}

.claim-btn {
  background: #12A87A;
}
.claim-card { padding: 32rpx; margin-bottom: 24rpx; }
.claim-title { font-size: 32rpx; font-weight: bold; margin-bottom: 16rpx; }
.claim-answer {
  font-size: 26rpx; color: #E5533D; background: #FDECEC;
  padding: 16rpx; border-radius: 12rpx; margin-bottom: 24rpx;
}
.claim-actions { display: flex; justify-content: flex-end; gap: 20rpx; }
.btn-reject { background: #F5F7F6; color: #6B7772; margin: 0; }
.btn-approve { background: #12A87A; color: #FFF; margin: 0; }

/* 状态颜色 */
.claim-status { font-size: 26rpx; color: #9AA5A0; }
.status-1 { color: #12A87A; font-weight: bold; }
.status-2 { color: #E5533D; }

.msg-box {
  background: #F5F7F6;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
}
.msg-text {
  font-size: 26rpx;
  color: #12A87A;
  font-weight: 500;
}
.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 20rpx;
}
.btn-msg {
  background: #FFF;
  color: #12A87A;
  border: 2rpx solid #12A87A;
  margin: 0;
}
.btn-msg::after { border: none; }
<view class="page">
  <!-- 顶部个人信息 -->
  <view class="profile">
    
    <!-- 🔥 未登录状态：只显示普通头像和文字，点击去登录 -->
    <block wx:if="{{!user}}">
      <view class="avatar-btn" bindtap="handleProfileTap">
        <view class="avatar">游</view>
      </view>
      <view class="info" bindtap="handleProfileTap">
        <text class="name-input">点击去登录</text>
        <text class="sub">登录后可发布和认领物品</text>
      </view>
    </block>

    <!-- 🔥 已登录状态：显示微信官方组件 -->
    <block wx:else>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{user.avatar_url}}" class="avatar-img" src="{{user.avatar_url}}" mode="aspectFill" />
        <view wx:else class="avatar">校</view>
      </button>
      
      <view class="info">
        <input 
          class="name-input" 
          type="nickname" 
          value="{{user.nickname || '校园用户'}}" 
          placeholder="点击这里获取微信昵称" 
          bindblur="onChooseNickname"
          bindconfirm="onChooseNickname"
        />
        <text class="sub">点击头像或昵称可修改</text>
      </view>
    </block>
  </view>

  <!-- 下面的菜单列表保持不变 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToMyItems">
      <text class="menu-label">我发布的</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" data-type="sent" bindtap="goToClaims">
      <text class="menu-label">我申请认领的</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" data-type="received" bindtap="goToClaims">
      <text class="menu-label">收到认领申请</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goToSettings">
      <text class="menu-label">设置</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>
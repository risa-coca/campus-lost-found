page { 
  height: 100vh; 
  display: flex; 
  flex-direction: column; 
  background: #F5F7F6; 
}

.chat-container { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
  height: 100%; 
  position: relative; 
}

/* 聊天记录区域 */
.chat-list { 
  flex: 1; 
  padding: 32rpx; 
  box-sizing: border-box; 
  padding-bottom: 350rpx; /* 🔥 留出底部输入框和 TabBar 的空间 */
}

.msg-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}
.row-ai { justify-content: flex-start; }
.row-user { justify-content: flex-end; }

/* 🔥 统一的头像样式（包含图片和默认文字兜底） */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

/* 针对没设置头像时的兜底背景 */
.user-avatar { 
  background: #E9F7F1; 
  color: #12A87A; 
}

/* 头像间距 */
.row-ai .avatar { margin-right: 16rpx; }
.row-user .avatar { margin-left: 16rpx; }

/* 消息内容盒子（包裹气泡和卡片） */
.msg-content-box {
  display: flex;
  flex-direction: column;
  max-width: 75%;
}

/* 聊天气泡 */
.bubble {
  max-width: 100%; 
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  overflow: hidden;
}
.bubble-ai { 
  background: #FFFFFF; 
  color: #1F2A26; 
  border-top-left-radius: 4rpx; 
  box-shadow: 0 4rpx 16rpx rgba(18, 168, 122, 0.05); 
}
.bubble-user { 
  background: #12A87A; 
  color: #FFFFFF; 
  border-top-right-radius: 4rpx; 
}

/* 图片气泡特殊处理 */
.bubble.image-bubble {
  background: transparent !important;
  padding: 0 !important;
  box-shadow: none !important;
}
.chat-img {
  width: 240rpx; 
  max-width: 100%;
  max-height: 320rpx; 
  border-radius: 12rpx;
  display: block;
}

/* 🔥 匹配结果卡片列表 */
.match-card-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.match-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #E9F7F1;
}
.match-card:active {
  background: #F5F7F6;
}

.match-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #E9F7F1;
  flex-shrink: 0;
}

.match-img-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #E9F7F1;
  color: #12A87A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.match-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.match-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1F2A26;
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.match-desc {
  font-size: 24rpx;
  color: #6B7772;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.match-loc {
  font-size: 22rpx;
  color: #9AA5A0;
}

.match-arrow {
  color: #C8D3CE;
  font-size: 32rpx;
  margin-left: 10rpx;
}

/* 🔥 底部输入栏（悬浮避开底部 TabBar） */
.input-bar {
  position: fixed; 
  bottom: 120rpx; /* 抬升避开底部红色的加号 TabBar */
  left: 0; 
  width: 100%;
  display: flex; 
  align-items: center;
  padding: 16rpx 24rpx; 
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.03);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); 
  box-sizing: border-box; 
  z-index: 100;
}

.input-box { 
  flex: 1; 
  min-width: 0; 
  height: 72rpx; 
  background: #F5F7F6; 
  border-radius: 36rpx; 
  padding: 0 24rpx; 
  font-size: 28rpx;
  margin-right: 8rpx;
}

.icon-btn {
  font-size: 44rpx;
  color: #6B7772;
  width: 60rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0; 
}

.send-btn { 
  width: 120rpx !important; 
  flex: none !important;    
  height: 72rpx; 
  background: #12A87A; 
  color: #FFF; 
  font-size: 28rpx; 
  padding: 0; 
  margin-left: 8rpx; 
  border-radius: 36rpx; 
  display: flex;
  align-items: center;
  justify-content: center;
}
.send-btn[disabled] { background: #A3D9C8; color: #FFF; }
.send-btn::after { border: none; }
<view class="container">
  <view class="card section">
    <view class="type-switch">
      <view class="type-option {{type === 0 ? 'active' : ''}}" data-type="0" bindtap="onTypeTap">我丢了东西</view>
      <view class="type-option {{type === 1 ? 'active' : ''}}" data-type="1" bindtap="onTypeTap">我捡到东西</view>
    </view>
  </view>

  <view class="card section">
    <view class="field">
      <text class="label">分类</text>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">{{categories[categoryIndex]}} ▾</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">标题</text>
      <input class="input" placeholder="如：黑色雨伞、校园卡" value="{{title}}" data-field="title" bindinput="onInput" maxlength="40" />
    </view>
    <view class="field column">
      <text class="label">详细描述</text>
      <textarea class="textarea" placeholder="尽量描述颜色、品牌、特殊标记等特征" value="{{description}}" data-field="description" bindinput="onInput" maxlength="500" auto-height />
    </view>
    <view class="field">
      <text class="label">地点</text>
      <input class="input" placeholder="如：图书馆三楼" value="{{location}}" data-field="location" bindinput="onInput" maxlength="40" />
    </view>
    <view class="field">
      <text class="label">时间</text>
      <picker mode="date" value="{{eventTime}}" bindchange="onTimeChange">
        <view class="picker-value">{{eventTime || '选择日期 ▾'}}</view>
      </picker>
    </view>
  </view>

  <view class="card section">
    <text class="label">图片（选填）</text>
    <view class="image-area">
      <view wx:if="{{imagePath}}" class="image-preview">
        <image src="{{imagePath}}" mode="aspectFill" />
        <view class="remove" bindtap="onRemoveImage">×</view>
        <view wx:if="{{uploading}}" class="uploading">上传中...</view>
      </view>
      <view wx:else class="image-add" bindtap="onChooseImage">
        <text class="plus">＋</text>
        <text class="hint">添加图片</text>
      </view>
    </view>
  </view>

  <button class="btn-primary submit" bindtap="onSubmit" loading="{{submitting}}">发布</button>
</view>

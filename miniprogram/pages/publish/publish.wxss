.section {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.type-switch {
  display: flex;
  background: #F5F7F6;
  border-radius: 20rpx;
  padding: 8rpx;
}

.type-option {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #6B7772;
  border-radius: 16rpx;
}

.type-option.active {
  background: #12A87A;
  color: #FFFFFF;
  font-weight: 600;
}

.field {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F3F1;
}

.field:last-child {
  border-bottom: none;
}

.field.column {
  flex-direction: column;
  align-items: flex-start;
}

.label {
  font-size: 28rpx;
  color: #1F2A26;
  width: 140rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #12A87A;
  text-align: right;
}

.textarea {
  width: 100%;
  margin-top: 16rpx;
  font-size: 28rpx;
  min-height: 120rpx;
}

.image-area {
  margin-top: 20rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #F5F7F6;
  border: 2rpx dashed #C8D3CE;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 56rpx;
  color: #12A87A;
}

.hint {
  font-size: 22rpx;
  color: #9AA5A0;
  margin-top: 6rpx;
}

.image-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.image-preview image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  background: #E5533D;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 32rpx;
}

.uploading {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
}

.submit {
  margin-top: 12rpx;
}
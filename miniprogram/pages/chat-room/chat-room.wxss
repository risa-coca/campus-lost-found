page { 
  height: 100vh; 
  display: flex; 
  flex-direction: column; 
  background: #F5F7F6; 
}

.chat-container { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
  overflow: hidden; /* 只允许内部滚动 */
}

/* 聊天记录区域：占据剩余的所有空间 */
.chat-list { 
  flex: 1; 
  padding: 32rpx; 
  box-sizing: border-box; 
}

.msg-row {
  display: flex;
  margin-bottom: 32rpx;
  align-items: flex-start;
}
.row-ai { justify-content: flex-start; }
.row-user { justify-content: flex-end; }

.avatar { width: 80rpx; height: 80rpx; border-radius: 40rpx; flex-shrink: 0; }
.text-avatar { display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: bold; color: #FFF; }
.bg-green { background: #12A87A; }
.bg-gray { background: #C8D3CE; }
.row-ai .avatar { margin-right: 16rpx; }
.row-user .avatar { margin-left: 16rpx; }

.bubble {
  max-width: 65%; 
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  overflow: hidden;
}
.bubble-ai { background: #FFFFFF; color: #1F2A26; border-top-left-radius: 4rpx; }
.bubble-user { background: #12A87A; color: #FFFFFF; border-top-right-radius: 4rpx; }

.bubble.image-bubble { background: transparent !important; padding: 0 !important; box-shadow: none !important; }
.chat-img { width: 240rpx; max-width: 100%; max-height: 320rpx; border-radius: 12rpx; display: block; }

/* 底部区域整体 */
.bottom-bar {
  flex-shrink: 0;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  /* 安全区底部留白，防止小黑条遮挡 */
  padding-bottom: env(safe-area-inset-bottom); 
}

.input-bar {
  display: flex; 
  align-items: center;
  /* 上 20rpx，左右 24rpx，下 40rpx（把高度彻底顶起来） */
  padding: 20rpx 24rpx 70rpx 24rpx; 
  box-sizing: border-box; 
}

.input-box { 
  flex: 1; min-width: 0; height: 72rpx; 
  background: #F5F7F6; border-radius: 36rpx; 
  padding: 0 24rpx; font-size: 28rpx; margin-right: 8rpx;
}

.icon-btn {
  font-size: 44rpx; color: #6B7772;
  width: 60rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; 
}

.send-btn { 
  width: 120rpx !important; flex: none !important; height: 72rpx; 
  background: #12A87A; color: #FFF; font-size: 28rpx; 
  padding: 0; margin-left: 8rpx; border-radius: 36rpx; 
  display: flex; align-items: center; justify-content: center;
}
.send-btn[disabled] { background: #A3D9C8; color: #FFF; }
.send-btn::after { border: none; }

/* 表情面板 */
.emoji-panel {
  height: 300rpx; 
  background: #F5F7F6;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  border-top: 1rpx solid #E5E9E7;
  overflow-y: auto;
}

.emoji-item {
  width: 16.66%; height: 80rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}